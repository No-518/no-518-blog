---
import { navigation, site } from '../config/site';
import { withBase } from '../utils/url';
const currentPath = Astro.url.pathname.replace(/\/$/, '');
---
<header class="site-header container">
  <a class="site-name" href={withBase('/')}>{site.name}</a>
  <div class="header-bottom">
    <p class="site-subtitle">研究、实践与日常</p>
    <nav class="site-nav" aria-label="主导航">
      {navigation.map((item) => (
        <a href={withBase(item.href)} aria-current={currentPath === withBase(item.href).replace(/\/$/, '') ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>
  </div>
</header>
