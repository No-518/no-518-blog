---
const { lang = 'zh-CN' } = Astro.props;
const english = lang === 'en';
// The same public widget ID is used on the personal homepage.
const widgetUrl = 'https://mapmyvisitors.com/map.js?d=MSSkJRxIMBm1INCgXbRPMgILxg_sNbSurztanECPLHs&cl=e4e7eb&co=ffffff&ct=707070&w=a';
---

<section class="visitor-map" aria-labelledby="visitor-map-heading" data-pagefind-ignore>
  <div class="visitor-map-intro">
    <h2 id="visitor-map-heading">{english ? 'Visitor map' : '访客足迹'}</h2>
    <p>Readers around the world</p>
  </div>
  <div class="visitor-map-content">
    <div class="visitor-map-canvas">
      <script is:inline async id="mapmyvisitors" src={widgetUrl}></script>
      <noscript>
        <a href="https://mapmyvisitors.com/web/1c9nx" aria-label={english ? 'Visitor statistics' : '访客统计'}>
          <img src="https://mapmyvisitors.com/map.png?d=MSSkJRxIMBm1INCgXbRPMgILxg_sNbSurztanECPLHs&cl=e4e7eb&co=ffffff" alt={english ? 'Map of approximate visitor locations' : '访客大致来源地图'} width="600" height="294" />
        </a>
      </noscript>
    </div>
    <p class="visitor-map-caption">
      {english ? 'Homepage + blog · ' : '个人主页与博客 · '}
      <a href="https://mapmyvisitors.com/web/1c9nx" target="_blank" rel="noopener noreferrer">{english ? 'Combined statistics' : '合并统计'}</a>
    </p>
    <p class="visitor-map-privacy">
      {english ? 'Approximate locations based on IP. ' : '位置根据 IP 大致定位。'}
      <a href="https://mapmyvisitors.com/b/policy" target="_blank" rel="noopener noreferrer">MapMyVisitors</a>
    </p>
  </div>
</section>
