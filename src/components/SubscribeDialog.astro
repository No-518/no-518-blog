---
import { newsletter } from '../config/site';
import { withBase } from '../utils/url';

const rssPath = withBase('/rss.xml');
const dialogId = Astro.props.dialogId ?? 'subscribe-dialog';
---

<>
  <button class="text-button" data-subscribe-open={dialogId} type="button">订阅 RSS</button>
  <dialog class="subscribe-dialog" id={dialogId} aria-labelledby={`${dialogId}-title`}>
    <div class="section-heading">
      <h2 id={`${dialogId}-title`}>订阅 RSS</h2>
      <button class="text-button" aria-label="关闭订阅窗口" data-subscribe-close={dialogId} type="button">关闭</button>
    </div>
    <p>{newsletter.description}</p>
    <p>将下面的地址添加到你常用的 RSS 阅读器，新文章会自动进入阅读列表。</p>
    <div class="rss-address"><span data-rss-value>{rssPath}</span></div>
    <div class="text-links">
      <button class="text-button" data-copy-rss={dialogId} type="button">复制 RSS 地址</button>
      <a href={rssPath} target="_blank" rel="noreferrer">打开 Feed ↗</a>
    </div>
    <p class="post-meta" data-copy-feedback={dialogId}>纯 RSS，无账号，无邮件打扰。</p>
  </dialog>

  <script is:inline define:vars={{ dialogId, rssPath }}>
    const dialog = document.getElementById(dialogId);
    const openButton = document.querySelector(`[data-subscribe-open="${dialogId}"]`);
    const closeButton = document.querySelector(`[data-subscribe-close="${dialogId}"]`);
    const copyButton = document.querySelector(`[data-copy-rss="${dialogId}"]`);
    const feedback = document.querySelector(`[data-copy-feedback="${dialogId}"]`);

    if (dialog instanceof HTMLDialogElement) {
      openButton?.addEventListener('click', () => {
        dialog.showModal();
      });

      closeButton?.addEventListener('click', () => {
        dialog.close();
      });

      dialog.addEventListener('click', (event) => {
        const rect = dialog.getBoundingClientRect();
        const inside =
          rect.top <= event.clientY &&
          event.clientY <= rect.top + rect.height &&
          rect.left <= event.clientX &&
          event.clientX <= rect.left + rect.width;
        if (!inside) dialog.close();
      });
    }

    copyButton?.addEventListener('click', async () => {
      const absoluteRssUrl = new URL(rssPath, window.location.origin).href;
      try {
        await navigator.clipboard.writeText(absoluteRssUrl);
        if (feedback) feedback.textContent = `已复制: ${absoluteRssUrl}`;
      } catch {
        if (feedback) feedback.textContent = `复制失败，请手动复制: ${absoluteRssUrl}`;
      }
    });
  </script>
</>
