---
import { site } from '../config/site';
import { withBase } from '../utils/url';
import ThemeToggle from './ThemeToggle.astro';
import VisitorMap from './VisitorMap.astro';
const { lang = site.language } = Astro.props;
---
<footer class="site-footer container">
  <VisitorMap lang={lang} />
  <div class="footer-main">
    <p>© {new Date().getFullYear()} {site.author}</p>
    <div class="footer-links">
      <a href={site.homepage}>个人主页</a>
      <a href="https://github.com/No-518">GitHub</a>
      <a href={withBase('/rss.xml')}>RSS</a>
      <a href={withBase('/projects')}>项目</a>
      <a href={withBase('/links')}>友链</a>
      <ThemeToggle />
    </div>
  </div>
</footer>
