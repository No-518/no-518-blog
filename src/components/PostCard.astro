---
import { withBase } from '../utils/url';
const { post } = Astro.props;
const href = withBase(`/blog/${post.slug}`);
const date = post.data.pubDate.toLocaleDateString('en', {
  month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC',
});
---
<article class="post-entry">
  <time class="entry-date" datetime={post.data.pubDate.toISOString()}>{date}</time>
  <div class="entry-copy">
    <h3><a href={href}>{post.data.title}</a></h3>
    <p>{post.data.description}</p>
    <a class="entry-category" href={withBase(`/blog/${post.data.categorySlug}`)}>{post.data.category}</a>
    {post.translations?.length > 1 ? (
      <nav class="translation-links" aria-label="文章语言">
        {post.translations.map((translation) => (
          <a href={withBase(`/blog/${translation.slug}`)} hreflang={translation.data.lang} lang={translation.data.lang}>
            {translation.data.lang === 'en' ? 'English' : '中文'}
          </a>
        ))}
      </nav>
    ) : null}
  </div>
</article>
