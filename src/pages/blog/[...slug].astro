---
import { getCollection } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await post.render();
const translations = post.data.translationKey
  ? (await getCollection('blog', ({ data }) => !data.draft && data.translationKey === post.data.translationKey))
  : [];
---

<PostLayout post={post} Content={Content} headings={post.data.toc ?? headings} translations={translations} />
