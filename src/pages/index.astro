---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import SubscribeDialog from '../components/SubscribeDialog.astro';
import { getPublishedPosts } from '../utils/content';
import { withBase } from '../utils/url';
const posts = await getPublishedPosts();
---
<BaseLayout>
  <section class="blog-intro" aria-label="博客简介">
    <p>我是 No-518，在这里写研究，也写生活。</p>
    <p class="intro-detail">关于 Embodied AI、Agent，以及做研究过程中的思考与实践。</p>
    <div class="text-links">
      <a href="https://no-518.github.io/">个人主页 ↗</a>
      <SubscribeDialog />
    </div>
  </section>
  <section class="home-section" aria-labelledby="latest-heading">
    <div class="section-heading journal-heading">
      <h1 id="latest-heading">最近的文字</h1>
      <a href={withBase('/blog')}>全部文章 ↗</a>
    </div>
    {posts.slice(0, 6).map((post) => <PostCard post={post} />)}
  </section>
</BaseLayout>
