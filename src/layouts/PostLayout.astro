---
import Comments from '../components/Comments.astro';
import BaseLayout from './BaseLayout.astro';
import { withBase } from '../utils/url';
import { site } from '../config/site';
const { post, Content, headings } = Astro.props;
---
<BaseLayout title={post.data.title} description={post.data.description} image={post.data.cover}>
  <article class="reading-page">
    <nav class="reading-navigation" aria-label="文章导航">
      <a href={site.homepage}>个人主页</a>
      <span aria-hidden="true">/</span>
      <a href={withBase('/blog')}>全部文章</a>
    </nav>
    <header class="article-header">
      <h1>{post.data.title}</h1>
      <div class="post-meta">
        <time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('zh-CN')}</time>
        {post.data.updatedDate ? <span>· 更新于 <time datetime={post.data.updatedDate.toISOString()}>{post.data.updatedDate.toLocaleDateString('zh-CN')}</time></span> : null}
      </div>
      <div class="text-links tag-list">
        {post.data.tags.map((tag, index) => <a href={withBase(`/tags/${post.data.tagSlugs[index]}`)}>#{tag}</a>)}
      </div>
    </header>
    {headings?.length ? (
      <details class="article-toc">
        <summary>文章目录</summary>
        <ul>{headings.map((heading) => <li style={`margin-left: ${Math.max(0, heading.depth - 2) * 0.75}rem`}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ul>
      </details>
    ) : null}
    <div class="prose dark:prose-invert">{Content ? <Content /> : null}</div>
    <footer class="article-footer">
      <a href={site.homepage}>{site.author}</a>
      <a href={withBase('/blog')}>继续阅读其他文章</a>
    </footer>
  </article>
  <Comments />
</BaseLayout>
