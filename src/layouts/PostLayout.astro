---
import BaseLayout from './BaseLayout.astro';
import { withBase } from '../utils/url';
import { site } from '../config/site';
import '../styles/weight-space-note.css';
const { post, Content, headings, translations = [] } = Astro.props;
const lang = post.data.lang;
const english = lang === 'en';
const alternateLanguages = translations.map((translation) => ({
  lang: translation.data.lang,
  href: withBase(`/blog/${translation.slug}`),
}));
---
<BaseLayout title={post.data.title} description={post.data.description} image={post.data.cover} lang={lang} alternateLanguages={alternateLanguages} reading>
  <article class="reading-page">
    <header class="article-header">
      <a class="article-category" href={withBase(`/blog/${post.data.categorySlug}`)}>{post.data.category}</a>
      <h1>{post.data.title}</h1>
      <p class="article-deck">{post.data.description}</p>
      <div class="article-byline">
      <div class="post-meta">
        <a href={site.homepage}>{english ? site.ownerName : site.ownerNameCn}</a>
        <span aria-hidden="true">·</span>
        <time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString(lang, { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}</time>
        {post.data.updatedDate ? <span>· {english ? 'Updated' : '更新于'} <time datetime={post.data.updatedDate.toISOString()}>{post.data.updatedDate.toLocaleDateString(lang, { timeZone: 'UTC' })}</time></span> : null}
      </div>
      {translations.length > 1 ? (
        <nav class="translation-links" aria-label={english ? 'Article language' : '文章语言'}>
          {translations.map((translation) => (
            <a href={withBase(`/blog/${translation.slug}`)} hreflang={translation.data.lang} lang={translation.data.lang} aria-current={translation.slug === post.slug ? 'page' : undefined}>
              {translation.data.lang === 'en' ? 'English' : '中文'}
            </a>
          ))}
        </nav>
      ) : null}
      </div>
      <div class="text-links tag-list">
        {post.data.tags.map((tag, index) => <a href={withBase(`/tags/${post.data.tagSlugs[index]}`)}>#{tag}</a>)}
      </div>
    </header>
    {headings?.length ? (
      <details class="article-toc">
        <summary>{english ? 'On this page' : '文章目录'}</summary>
        <ul>{headings.map((heading) => <li style={`margin-left: ${Math.max(0, heading.depth - 2) * 0.75}rem`}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ul>
      </details>
    ) : null}
    <div class="prose dark:prose-invert">{Content ? <Content /> : null}</div>
    <footer class="article-footer">
      <a href={site.homepage}>{site.author}</a>
      <a href={withBase('/blog')}>{english ? 'Read more posts' : '继续阅读其他文章'}</a>
    </footer>
  </article>
</BaseLayout>

<script>
  // Keep assets in the route layout: legacy MDX rendering does not hoist
  // styles/scripts imported only by its nested Astro components.
  import '../scripts/article-media';
</script>
