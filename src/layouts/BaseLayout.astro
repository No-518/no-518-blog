---
import Analytics from '../components/Analytics.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Seo from '../components/Seo.astro';
import ThemeScript from '../components/ThemeScript.astro';
import { blogNavigation, site } from '../config/site';
import { withBase } from '../utils/url';
import '../styles/global.css';

const { title, description, image, lang = site.language, alternateLanguages = [], reading = false } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, '');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ThemeScript />
    <Seo title={title} description={description} image={image} />
    {alternateLanguages.map((alternate) => (
      <link rel="alternate" hreflang={alternate.lang} href={new URL(alternate.href, Astro.site)} />
    ))}
    <Analytics />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.name}
      href={withBase('rss.xml')}
    />
  </head>
  <body class:list={{ 'reading-layout': reading }}>
    <a class="skip-link" href="#main-content">{lang === 'en' ? 'Skip to content' : '跳到正文'}</a>
    <Header compact={reading} lang={lang} />
    <main id="main-content" class="container page-main">
      {!reading ? <div class="blog-context">
        <a class="blog-name" href={withBase('/')}>Blog · {site.name}</a>
        <nav class="blog-nav" aria-label={lang === 'en' ? 'Blog navigation' : '博客导航'}>
          {blogNavigation.map((item, index) => (
            <a href={withBase(lang === 'en' && item.href === '/search' ? '/search-en' : item.href)} aria-current={
              currentPath === withBase(lang === 'en' && item.href === '/search' ? '/search-en' : item.href).replace(/\/$/, '') ||
              (item.href === '/blog' && currentPath.startsWith(`${withBase('/blog')}/`))
                ? 'page' : undefined
            }>{lang === 'en' ? ['Posts', 'Tags', 'About', 'Search'][index] : item.label}</a>
          ))}
        </nav>
      </div> : null}
      <slot />
    </main>
    <Footer />
  </body>
</html>
